#!/usr/bin/env python3
from pathlib import Path
import subprocess
import sys

root = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(root))
from cual.runtime import main
try:
    main(root, sys.argv[1:])
except (ValueError, OSError, subprocess.SubprocessError) as exc:
    sys.exit(f'Cual: {exc}')
